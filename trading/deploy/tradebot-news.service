[Unit]
Description=tradebot news agent (headline classification -> avoid list)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/tradebot
ExecStart=/opt/tradebot/.venv/bin/python -m agents.news_agent
Restart=always
RestartSec=30
MemoryMax=150M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradebot/state /opt/tradebot/logs

[Install]
WantedBy=multi-user.target
