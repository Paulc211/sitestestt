[Unit]
Description=tradebot dashboard (FastAPI, bound to localhost — front with nginx/caddy or SSH tunnel)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/tradebot
ExecStart=/opt/tradebot/.venv/bin/uvicorn dashboard.app:app --host 127.0.0.1 --port 8899
Restart=always
RestartSec=10
MemoryMax=180M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradebot/state /opt/tradebot/logs

[Install]
WantedBy=multi-user.target
