[Unit]
Description=tradebot trading agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/tradebot
ExecStart=/opt/tradebot/.venv/bin/python -m agents.trading_agent
Restart=always
RestartSec=15
# survive-a-crash-loop backstop: if it dies 5 times in 10 min systemd pauses it,
# and the watchdog will have written halt.flag long before that
StartLimitIntervalSec=600
StartLimitBurst=5
MemoryMax=200M
Nice=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradebot/state /opt/tradebot/logs

[Install]
WantedBy=multi-user.target
