[Unit]
Description=tradebot reality-check agent (live vs backtest divergence)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/tradebot
ExecStart=/opt/tradebot/.venv/bin/python -m agents.reality_check_agent
Restart=always
RestartSec=60
MemoryMax=120M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradebot/state /opt/tradebot/logs

[Install]
WantedBy=multi-user.target
