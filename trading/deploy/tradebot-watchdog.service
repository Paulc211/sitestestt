[Unit]
Description=tradebot watchdog agent (independent risk enforcement)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tradebot
WorkingDirectory=/opt/tradebot
ExecStart=/opt/tradebot/.venv/bin/python -m agents.watchdog_agent
Restart=always
RestartSec=10
MemoryMax=150M
# the watchdog must be able to SIGKILL the trading agent, which runs as the
# same user — no extra privileges needed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/tradebot/state /opt/tradebot/logs

[Install]
WantedBy=multi-user.target
