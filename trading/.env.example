# ============================================================
# tradebot .env — copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env && chmod 600 .env
# ============================================================

# ---- MODE (safety-critical) --------------------------------
# Anything other than the exact pair below runs in PAPER mode.
# To go live you must set BOTH:
#   MODE=live
#   LIVE_TRADING_CONFIRM=YES_I_UNDERSTAND_REAL_MONEY
MODE=paper
LIVE_TRADING_CONFIRM=

# ---- Alpaca ------------------------------------------------
# Paper keys: https://app.alpaca.markets (paper account section)
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
# Live keys — leave blank until you have paper-traded for weeks
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=

# ---- Coinbase Advanced Trade (LIVE crypto only, optional) --
# CDP API key. If blank, live crypto trades on Alpaca instead.
# Paper mode never touches Coinbase.
# The private key is the PEM; keep the \n escapes as downloaded.
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# ---- Anthropic (news classification) -----------------------
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5
ANTHROPIC_MODEL=

# ---- Telegram alerts ---------------------------------------
# Create a bot with @BotFather; get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard auth ----------------------------------------
# Long random password: openssl rand -base64 24
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
